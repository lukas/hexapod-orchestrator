{
    storage file_system /workspace/.caddy
}

# Single sign-on for every lab site. Browsers without the hexapod_sso cookie
# are sent to the sign-in form on this host; the cookie is scoped to the
# whole cluster domain, so one login covers camera, robot-lab and buildviz
# too. Keyless paths, the LLM index, MCP, keyed script URLs, and anything
# already carrying a credential are left to the app's own gate.
hexapod.cwd1f0-new-cluster.coreweave.app {
    @browser {
        not header Authorization *
        not path / /hub /llms.txt /llm /llm/* /robots.txt /mcp /login /logout /auth
        not query key=*
    }
    forward_auth @browser 127.0.0.1:8090 {
        uri /auth
        copy_headers X-Hexapod-User
        header_up X-Hexapod-Original {http.request.scheme}://{http.request.host}{http.request.uri}
    }
    reverse_proxy 127.0.0.1:8090
}
